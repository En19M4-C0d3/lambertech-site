---
interface Props {
	title: string;
	icon?: string;
}
const { title, icon } = Astro.props;
---
<details class="accordion">
	<summary>
		<span class="accordion-title">{icon && <span>{icon}</span>} {title}</span>
		<span class="chevron">▼</span>
	</summary>
	<div class="accordion-body">
		<slot />
	</div>
</details>

<style>
	.accordion {
		border: 1px solid rgba(var(--gray), 25%);
		border-radius: 10px;
		margin-bottom: 0.8em;
		background: rgb(var(--gray-light));
		overflow: hidden;
	}
	.accordion summary {
		list-style: none;
		cursor: pointer;
		padding: 0.9em 1.1em;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1em;
		font-weight: 600;
		color: rgb(var(--black));
	}
	.accordion summary::-webkit-details-marker {
		display: none;
	}
	.accordion-title {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.chevron {
		color: var(--accent);
		transition: transform 0.2s ease;
		font-size: 0.75em;
		flex-shrink: 0;
	}
	.accordion[open] .chevron {
		transform: rotate(180deg);
	}
	.accordion[open] summary {
		border-bottom: 1px solid rgba(var(--gray), 20%);
	}
	.accordion-body {
		padding: 1em 1.1em 1.2em;
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
		line-height: 1.6;
	}
	.accordion-body :global(strong) {
		color: rgb(var(--black));
	}
	.accordion-body :global(p) {
		margin-bottom: 0.8em;
	}
</style>

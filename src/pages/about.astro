---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const certs = ['CompTIA A+', 'Network+', 'Security+', 'CySA+'];
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="A quick look at who I am and the pivot I'm making into IT and security." />
		<style>
			main {
				max-width: 640px;
				margin: 0 auto;
				padding: 4em 1em;
			}
			.tag {
				font-family: var(--font-mono);
				font-size: 0.85em;
				color: var(--accent);
				margin-bottom: 0.6em;
			}
			h1 {
				margin-bottom: 0.6em;
			}
			.lede {
				font-size: 1.1em;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.6em;
			}
			.certs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin: 1.6em 0 2em;
			}
			.cert-pill {
				font-family: var(--font-mono);
				font-size: 0.8em;
				padding: 0.4em 0.8em;
				border: 1px solid var(--accent);
				border-radius: 5px;
				color: var(--accent);
			}
			.now-box {
				border: 1px solid rgba(var(--gray), 20%);
				border-radius: 10px;
				padding: 1.2em 1.4em;
				margin: 2em 0;
			}
			.now-box h3 {
				font-family: var(--font-mono);
				font-size: 0.8em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.6em;
			}
			.contact-row {
				display: flex;
				gap: 1em;
				flex-wrap: wrap;
				margin-top: 2em;
			}
			.contact-row a {
				font-size: 0.95em;
				padding: 0.5em 1em;
				border-radius: 6px;
				text-decoration: none;
			}
			.contact-primary {
				background: var(--accent);
				color: rgb(11, 14, 17);
				font-weight: 700;
			}
			.contact-secondary {
				border: 1px solid rgba(var(--gray), 40%);
				color: rgb(var(--gray-dark));
			}
			.more-link {
				display: inline-block;
				margin-top: 1.8em;
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tag">about</div>
			<h1>Eljay Lambert</h1>
			<p class="lede">
				Former Senior Teaching Assistant and Specialist Teacher, now building a career in IT and security —
				one certification, one project, and one home lab experiment at a time.
			</p>

			<p>
				Eight years supporting SEND students taught me how to manage pressure, communicate clearly to
				different audiences, and hold to process even when it's inconvenient — skills that turned out to
				transfer directly into security work. I'm now pivoting deliberately toward IT and OT/ICS security,
				building the practical evidence to back up the theory.
			</p>

			<div class="certs">
				{certs.map((cert) => <span class="cert-pill">{cert}</span>)}
			</div>

			<div class="now-box">
				<h3>Right now</h3>
				<p>
					Building an IT/OT segmented home lab from scratch, working toward OT/ICS security roles, and
					documenting the whole journey — the wins and the debugging sessions — here on this site.
				</p>
			</div>

			<a class="more-link" href="/blog/why-i-started-this-site/">Read the full story on why I started this site →</a>

			<div class="contact-row">
				<a class="contact-primary" href="mailto:eljay@lambertech.co.uk">Email me</a>
				<a class="contact-secondary" href="https://www.linkedin.com/in/eljay-lambert-9a46422ba/" target="_blank">LinkedIn</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
